APP_NAME='Tir Lavigny'
APP_ENV=production
APP_KEY=                         # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://tir-lavigny.ch

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --------------------------------------------------------------------------
# Base de données (MariaDB - service "db" du docker-compose.prod.yml)
# --------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tir_lavigny
DB_USERNAME=tir_lavigny
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Mot de passe root MariaDB (utilisé par docker-compose.prod.yml)
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# --------------------------------------------------------------------------
# Pulse & Telescope - même base que l'application
# --------------------------------------------------------------------------
PULSE_DB_CONNECTION=mysql
TELESCOPE_DB_CONNECTION=mysql

# --------------------------------------------------------------------------
# Cache, sessions, queues
# --------------------------------------------------------------------------
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# --------------------------------------------------------------------------
# Mail (configure avec ton fournisseur SMTP réel)
# --------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.infomaniak.com
MAIL_PORT=587
MAIL_USERNAME=your@tir-lavigny.ch
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@tir-lavigny.ch
MAIL_FROM_NAME='Tir Lavigny'

# --------------------------------------------------------------------------
# Nightwatch (optionnel)
# --------------------------------------------------------------------------
NIGHTWATCH_TOKEN=
