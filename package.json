        "@vue/test-utils": "^2.4.6",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-vue": "^10.12.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "remove-attr": "^0.0.15",
